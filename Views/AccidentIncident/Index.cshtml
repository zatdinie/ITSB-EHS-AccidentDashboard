@model IEnumerable<ITSB.AccidentDashboard.Core.Entities.AccidentIncident>
@{ ViewBag.Title = "Accident Summary"; }

<div class="esh-subheader dashboard-subheader">
    <span>YEAR&nbsp;</span>
    <select id="accident-year" aria-label="Select accident summary year" onchange="window.location.href = window.location.pathname + '?year=' + this.value;">
        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
        {
            <option value="@y" selected="@(y == (int)ViewBag.Year)">@y</option>
        }
    </select>
    <span>&nbsp;| ACCIDENT SUMMARY</span>
</div>

<div class="container-fluid" style="padding:20px;">
    <div class="page-title-bar">
        <h2>Accident Summary</h2>
        @Html.ActionLink("+ Report New Incident", "Create", null, new { @class = "btn btn-primary" })
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="content-card" style="overflow-x:auto; padding:0;">
        <table class="table" style="margin-bottom:0;">
            <tr>
                <th style="width:40px; text-align:center;">No</th>
                <th>Workers Name</th>
                <th>IC / Passport No</th>
                <th>Employee ID</th>
                <th>Plant</th>
                <th>Gender</th>
                <th>Age</th>
                <th>Nationality</th>
                <th>Employment Status</th>
                <th>Date</th>
                <th>Time of Occurrence</th>
                <th style="min-width:300px;">How Accident Happened</th>
                <th style="width:150px;"></th>
            </tr>
            @{ int rowNum = 1; }
            @foreach (var i in Model)
            {
                <tr>
                    <td style="text-align:center;">@rowNum</td>
                    <td>@i.WorkerName</td>
                    <td style="text-align:center;">@i.IcPassportNo</td>
                    <td style="text-align:center;">@i.EmployeeId</td>
                    <td style="text-align:center;">@(i.Plant != null ? i.Plant.PlantCode : "-")</td>
                    <td style="text-align:center;">@(i.Gender == "Male" ? "M" : i.Gender == "Female" ? "F" : i.Gender)</td>
                    <td style="text-align:center;">@i.Age</td>
                    <td style="text-align:center;">@i.Nationality</td>
                    <td style="text-align:center;">@i.EmploymentStatus</td>
                    <td style="text-align:center;">@i.DateOfOccurrence.ToString("dd/MM/yyyy")</td>
                    <td style="text-align:center;">@i.TimeOfOccurrence.ToString(@"hh\:mm")</td>
                    <td style="white-space:pre-line;">@i.HowAccidentHappened@(i.LostWorkDays > 0 ? "\nLost Work Day: " + i.LostWorkDays + " days MC" : "")</td>
                    <td style="text-align:center;">
                        @Html.ActionLink("Edit", "Edit", new { id = i.Id }, new { @class = "btn btn-sm btn-default" })
                        @Html.ActionLink("Delete", "Delete", new { id = i.Id }, new { @class = "btn btn-sm btn-danger" })
                    </td>
                </tr>
                rowNum++;
            }
        </table>
    </div>
</div>