@using System;
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ITSB ESH Accident Dashboard</title>
    @Styles.Render("~/Content/accident/css")
    @Scripts.Render("~/bundles/accident/modernizr")
    <link href="~/Areas/ACCIDENT/Content/Style.css" rel="stylesheet" />
</head>
<body>
    @{
    string currentController = ViewContext.RouteData.Values["controller"].ToString();
    Func<string, string> navClass = ctrl => currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
    <div class="esh-header">
        <img src="~/Areas/ACCIDENT/Content/Images/favicon-512-2.png" alt="Company Logo" onerror="this.style.display='none'" />
        <div class="title">ITSB ESH<br />ACCIDENT DASHBOARD</div>
        <nav class="esh-nav" aria-label="Main navigation">
            <a href="@Url.Action("Index", "Dashboard")" class="@navClass("Dashboard")">Dashboard</a>
            <a href="@Url.Action("Index", "StatusByPlant")" class="@navClass("StatusByPlant")">Status By Plant</a>
            <a href="@Url.Action("Index", "AccidentAnalysis")" class="@navClass("AccidentAnalysis")">Accident Analysis</a>
            <a href="@Url.Action("Index", "LWR")" class="@navClass("LWR")">Lost Work Day Rate</a>
            <a href="@Url.Action("Index", "AccidentIncident")" class="@navClass("AccidentIncident")">Accident Summary</a>
        </nav>
    </div>
        <div class="utility-bar">
            @Html.ActionLink("Master Data", "Index", "MasterData")
    </div>
    <div class="container-fluid body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - ITSB ESH Accident Dashboard</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/accident/jquery")
    @Scripts.Render("~/bundles/accident/bootstrap")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>