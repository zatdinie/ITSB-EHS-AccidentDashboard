@model ITSB.AccidentDashboard.Web.Models.AccidentAnalysisPageViewModel
@using System.Linq
@{ ViewBag.Title = "Accident Analysis"; }

<div class="esh-subheader dashboard-subheader">
    <span>YEAR&nbsp;</span>
    <select id="analysis-year" aria-label="Select year" onchange="window.location.href = window.location.pathname + '?year=' + this.value;">
        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
        {
            <option value="@y" selected="@(y == Model.Year)">@y</option>
        }
    </select>
    <span>&nbsp;| ACCIDENT ANALYSIS</span>
</div>

<div class="analysis-toggle-bar">
    <h4>Click On The Items</h4>
    <button class="analysis-toggle-btn active" onclick="showPanel('causeByPlant', this)">Cause Of Accident by Plant</button>
    <button class="analysis-toggle-btn" onclick="showPanel('occupational', this)">Accident Analysis by Occupational Accidents</button>
</div>

<div id="panel-causeByPlant" class="container-fluid" style="padding:20px;">
    <div class="content-card" style="overflow-x:auto;">
        <h4 style="text-align:center;">Cause of Accident By Plant @Model.Year</h4>
        <table class="table" style="font-size:12px;">
            <tr>
                <th>Plant</th>
                @foreach (var c in Model.CauseByPlant.CauseNames) { <th>@c</th> }
            </tr>
            @foreach (var row in Model.CauseByPlant.Rows)
            {
                <tr>
                    <td><strong>@row.PlantCode</strong></td>
                    @foreach (var c in Model.CauseByPlant.CauseNames) { <td>@row.CauseCounts[c]</td> }
                </tr>
            }
            <tr style="background:var(--navy-dark); color:#fff; font-weight:700;">
                <td>TOTAL (ALL PLANT)</td>
                @foreach (var c in Model.CauseByPlant.CauseNames) { <td>@Model.CauseByPlant.Totals[c]</td> }
            </tr>
        </table>
    </div>
    <br />

    <div class="row">
        @foreach (var row in Model.CauseByPlant.Rows)
        {
            <div class="col-md-6" style="margin-bottom:20px;">
                <div class="chart-card-dark" style="height:360px;">
                    <h4>Plant @row.PlantCode</h4>
                    <div class="chart-wrap"><canvas id="chartPlant_@row.PlantCode"></canvas></div>
                </div>
            </div>
        }
    </div>
</div>

<div id="panel-occupational" class="container-fluid" style="padding:20px; display:none;">
    <div class="row occupational-card-row">
        <div class="col-md-6">
            <div class="content-card occupational-card">
                <h4 style="text-align:center;">Accident Analysis by Occupational Accidents</h4>
                <table class="table occupational-table" style="font-size:12px;">
                    <tr>
                        <th>Month</th>
                        @foreach (var n in Model.MonthlyInjury.InjuryTypeNames) { <th>@n</th> }
                        <th>Total</th>
                    </tr>
                    @foreach (var row in Model.MonthlyInjury.Rows)
                    {
                        <tr>
                            <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(row.Month)</td>
                            @foreach (var n in Model.MonthlyInjury.InjuryTypeNames) { <td>@row.Counts[n]</td> }
                            <td><strong>@row.RowTotal</strong></td>
                        </tr>
                    }
                    <tr style="background:var(--navy-dark); color:#fff; font-weight:700;">
                        <td>TOTAL</td>
                        @foreach (var n in Model.MonthlyInjury.InjuryTypeNames) { <td>@Model.MonthlyInjury.ColumnTotals[n]</td> }
                        <td>@Model.MonthlyInjury.GrandTotal</td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <div class="chart-card occupational-card">
                <h4>Accident Analysis by Occupational Accidents</h4>
                <div class="chart-wrap"><canvas id="chartMonthlyInjury"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    function showPanel(name, btn) {
        document.getElementById('panel-causeByPlant').style.display = name === 'causeByPlant' ? 'block' : 'none';
        document.getElementById('panel-occupational').style.display = name === 'occupational' ? 'block' : 'none';
        document.querySelectorAll('.analysis-toggle-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
    }

    var commonOpts = { maintainAspectRatio: false, responsive: true };
    var causeLabels = @Html.Raw(Json.Encode(Model.CauseByPlant.CauseNames));

    @foreach (var row in Model.CauseByPlant.Rows)
    {
        <text>
        new Chart(document.getElementById('chartPlant_@row.PlantCode'), {
            type: 'bar',
            data: {
                labels: causeLabels,
                datasets: [{ data: @Html.Raw(Json.Encode(Model.CauseByPlant.CauseNames.Select(c => row.CauseCounts[c]))), backgroundColor: '#5B9BD5' }]
            },
            options: Object.assign({}, commonOpts, {
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: { x: { ticks: { color: '#fff' } }, y: { ticks: { color: '#fff', font: { size: 9 } } } }
            })
        });
        </text>
    }

    var monthLabels = @Html.Raw(Json.Encode(Model.MonthlyInjury.Rows.Select(r => System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(r.Month))));
    var injuryNames = @Html.Raw(Json.Encode(Model.MonthlyInjury.InjuryTypeNames));
    var injuryColors = ['#5B9BD5', '#ED7D31', '#A5A5A5', '#FFC000', '#4472C4', '#70AD47'];

    var injuryCountsByName = @Html.Raw(Json.Encode(
        Model.MonthlyInjury.InjuryTypeNames.ToDictionary(n => n, n => Model.MonthlyInjury.Rows.Select(r => r.Counts[n]).ToList())
    ));

    var injuryDatasets = injuryNames.map(function (name, idx) {
        return {
            label: name,
            backgroundColor: injuryColors[idx % injuryColors.length],
            data: injuryCountsByName[name]
        };
    });
    injuryDatasets.push({
        label: 'Total',
        backgroundColor: '#1B2A49',
        data: @Html.Raw(Json.Encode(Model.MonthlyInjury.Rows.Select(r => r.RowTotal)))
    });

    new Chart(document.getElementById('chartMonthlyInjury'), {
        type: 'bar',
        data: { labels: monthLabels, datasets: injuryDatasets },
        options: Object.assign({}, commonOpts, { plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } } } })
    });
</script>
}