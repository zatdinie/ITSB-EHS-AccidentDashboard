@model ITSB.AccidentDashboard.Core.Entities.Plant
@{ ViewBag.Title = "Edit Plant"; }

<div class="container-fluid" style="padding:20px;">
    <div class="page-title-bar"><h2>Edit Plant</h2></div>

    <div class="content-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(m => m.Id)

            <div class="form-group">
                @Html.LabelFor(m => m.PlantCode)
                @Html.TextBoxFor(m => m.PlantCode, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PlantCode)
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Name)
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Name)
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
        }
    </div>
</div>