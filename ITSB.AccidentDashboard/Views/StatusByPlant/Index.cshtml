@model IEnumerable<ITSB.AccidentDashboard.Core.Repositories.PlantStatusResult>
@{ ViewBag.Title = "Status By Plant"; }

<div class="esh-subheader dashboard-subheader">
    <span>YEAR&nbsp;</span>
    <select id="status-year" onchange="window.location.href = window.location.pathname + '?year=' + this.value;">
        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
        {
            <option value="@y" selected="@(y == ViewBag.Year)">@y</option>
        }
    </select>
    <span>&nbsp;| STATUS BY PLANT</span>
</div>

<div class="container-fluid" style="padding:20px;">
    <div class="chart-card">
        <table class="table table-striped">
            <tr>
                <th>Plant</th><th>Total Cases</th><th>First Aid</th><th>Lost Work Day Cases</th><th>Recordable</th><th>Total Lost Work Days</th>
            </tr>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.PlantCode - @r.PlantName</td>
                    <td>@r.TotalCases</td>
                    <td>@r.FirstAidCases</td>
                    <td>@r.LostWorkDayCases</td>
                    <td>@r.RecordableCases</td>
                    <td>@r.TotalLostWorkDays</td>
                </tr>
            }
        </table>
    </div>
</div>