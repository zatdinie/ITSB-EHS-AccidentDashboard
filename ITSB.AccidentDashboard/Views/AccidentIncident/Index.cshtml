@model IEnumerable<ITSB.AccidentDashboard.Core.Entities.AccidentIncident>
@{ ViewBag.Title = "Accident Summary"; }

<h2>Accident Summary</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<p>@Html.ActionLink("Report New Incident", "Create", null, new { @class = "btn btn-primary" })</p>
<table class="table table-striped">
    <tr>
        <th>Date</th><th>Worker</th><th>Plant</th><th>Body Part</th><th>Cause</th><th>Lost Work Days</th><th></th>
    </tr>
    @foreach (var i in Model)
    {
        <tr>
            <td>@i.DateOfOccurrence.ToString("dd/MM/yyyy")</td>
            <td>@i.WorkerName</td>
            <td>@(i.Plant != null ? i.Plant.PlantCode : "-")</td>
            <td>@(i.BodyPart != null ? i.BodyPart.Name : "-")</td>
            <td>@(i.AccidentCause != null ? i.AccidentCause.Description : "-")</td>
            <td>@i.LostWorkDays</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = i.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id = i.Id })
            </td>
        </tr>
    }
</table>