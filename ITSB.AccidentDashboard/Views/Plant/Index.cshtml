@model IEnumerable<ITSB.AccidentDashboard.Core.Entities.Plant>
@{ ViewBag.Title = "Plants"; }

<h2>Plants</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<p>@Html.ActionLink("Create New Plant", "Create")</p>
<table class="table">
    <tr><th>Code</th><th>Name</th><th></th></tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.PlantCode</td>
            <td>@p.Name</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = p.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id = p.Id })
            </td>
        </tr>
    }
</table>