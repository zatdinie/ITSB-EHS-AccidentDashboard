@model IEnumerable<ITSB.AccidentDashboard.Core.Entities.MonthlyManHours>
@{ ViewBag.Title = "Monthly Man Hours"; }

<div class="container-fluid" style="padding:20px;">
    <div class="page-title-bar">
        <h2>Monthly Man Hours</h2>
        @Html.ActionLink("+ Add Entry", "Create", null, new { @class = "btn btn-primary" })
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="content-card">
        <table class="table">
            <tr>
                <th>Year</th>
                <th>Month</th>
                <th>Plant</th>
                <th>DL Headcount</th>
                <th>DL Hours</th>
                <th>IDL Headcount</th>
                <th>IDL Hours</th>
                <th>Total Hours</th>
                <th style="width:180px;"></th>
            </tr>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Year</td>
                    <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m.Month)</td>
                    <td>@(m.Plant != null ? m.Plant.Code : "-")</td>
                    <td>@m.DirectLaborHeadcount</td>
                    <td>@m.DirectLaborHours.ToString("N0")</td>
                    <td>@m.IndirectLaborHeadcount</td>
                    <td>@m.IndirectLaborHours.ToString("N0")</td>
                    <td><strong>@((m.DirectLaborHours + m.IndirectLaborHours).ToString("N0"))</strong></td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = m.Id }, new { @class = "btn btn-sm btn-default" })
                        @Html.ActionLink("Delete", "Delete", new { id = m.Id }, new { @class = "btn btn-sm btn-danger" })
                    </td>
                </tr>
            }
        </table>
    </div>
</div>