@model IEnumerable<ITSB.AccidentDashboard.Core.Entities.AccidentCause>
@{ ViewBag.Title = "Accident Cause"; }
<h2>Accident Cause</h2>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<p>@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })</p>
<table class="table table-striped">
    <tr><th>Name</th><th></th></tr>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.Name</td>
            <td>@Html.ActionLink("Edit", "Edit", new { id = b.Id }) | @Html.ActionLink("Delete", "Delete", new { id = b.Id })</td>
        </tr>
    }
</table>