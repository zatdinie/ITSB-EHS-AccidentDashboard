@model ITSB.AccidentDashboard.Core.Entities.AccidentCause
@{ ViewBag.Title = "Delete Accident Cause"; }

<div class="container-fluid" style="padding:20px;">
    <div class="page-title-bar"><h2>Delete Accident Cause</h2></div>

    <div class="content-card">
        <p>Are you sure you want to delete <strong>@Model.Description</strong>?</p>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <button type="submit" class="btn btn-danger">Delete</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
        }
    </div>
</div>