<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ITSB ESH Accident Dashboard</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/Style.css" rel="stylesheet" />
</head>
<body>
    <div class="esh-header">
        <img src="~/Content/images/logo.png" alt="Company Logo" onerror="this.style.display='none'" />
        <div class="title">ITSB ESH<br />ACCIDENT DASHBOARD</div>
    </div>
    <div class="esh-nav">
        @Html.ActionLink("Dashboard", "Index", "Dashboard")
        @Html.ActionLink("Status By Plant", "Index", "StatusByPlant")
        @Html.ActionLink("Accident Analysis", "Index", "AccidentAnalysis")
        @Html.ActionLink("Lost Work Day Rate", "Index", "LWR")
        @Html.ActionLink("Accident Summary", "Index", "AccidentIncident")
    </div>
    <div style="text-align:right; padding:6px 20px; background:#E8ECF3;">
    @Html.ActionLink("⚙ Master Data", "Index", "MasterData")
    </div>
    <div class="esh-subheader" style="text-align:right; padding-right:20px;">
        <label style="margin-right:8px;">Year:</label>
        <select onchange="window.location.href = window.location.pathname + '?year=' + this.value;">
            @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
            {
                <option value="@y" selected="@(y == (ViewBag.Year ?? DateTime.Now.Year))">@y</option>
            }
        </select>
    </div>
    <div class="container-fluid body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - ITSB ESH Accident Dashboard</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>